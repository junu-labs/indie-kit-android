<?xml version="1.0" encoding="utf-8"?>
<!--
  역할
   - indie-kit-ads 의 매니페스트.
   - AdMob app id 와 광고가 요구하는 권한 (INTERNET, AD_ID) 을 미리 선언.
   - 사용처 앱의 매니페스트와 자동 merge 되므로 따로 적을 필요 없음.

  주의사항
   - APPLICATION_ID 는 Google 공식 *테스트* app id 가 기본값.
     사용처 앱은 출시 직전 자기 매니페스트의 같은 키를 실제 AdMob app id 로 *덮어쓴다*:
     ```xml
     <meta-data
         android:name="com.google.android.gms.ads.APPLICATION_ID"
         android:value="ca-app-pub-XXXXXXXXXXXXXXXX~XXXXXXXXXX"
         tools:replace="android:value" />
     ```
   - 패키지 namespace 는 build.gradle.kts 의 android.namespace 가 담당.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 광고 요청에 필요한 네트워크 권한. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Android 13+ 광고 ID 접근 권한. AdMob SDK 가 자동 사용. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />

    <application>
        <!--
          Google 공식 테스트 app id (출처: https://developers.google.com/admob/android/test-ads).
          사용처 앱이 출시 직전 자기 매니페스트에서 tools:replace 로 실제 id 로 덮어쓴다.
        -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713" />

        <!--
          "지금 떠 있는 화면" 추적자 자동 시동 (CurrentActivityTracker.kt 참고).
          안드로이드가 앱 시작 순간 (어떤 화면보다 먼저) 이 장치를 깨워 추적을 심는다.
          앱이 configure 를 화면 뒤로 미뤄 불러도 유럽 동의창을 띄울 화면을 놓치지 않기 위함.
          authorities 의 ${applicationId} 는 합쳐질 때 각 앱의 패키지 이름으로 바뀌므로
          여러 앱이 같은 모듈을 써도 서로 겹치지 않는다.
        -->
        <provider
            android:name="kr.co.junu.indiekit.ads.IndieKitAdsInitProvider"
            android:authorities="${applicationId}.indiekitadsinitprovider"
            android:exported="false" />
    </application>

</manifest>
